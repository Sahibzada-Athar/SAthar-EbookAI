         } catch (err) {
             console.error("finalizeChapter error:", err);
             statusEl.innerHTML = `<span class="text-danger">Finalize failed: ${err.message}</span>`;
             if (changeBtn) changeBtn.disabled = false;
             if (finalizeBtn) finalizeBtn.disabled = false;
         }
     }
